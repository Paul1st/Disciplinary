[
 {
  "absolute_value": 0,
  "align_labels_right": 0,
  "css": null,
  "custom_format": 1,
  "default_print_language": "en",
  "disabled": 0,
  "doc_type": "Disciplinary",
  "docstatus": 0,
  "doctype": "Print Format",
  "font": null,
  "font_size": 14,
  "format_data": null,
  "html": "<style>\n    * { box-sizing: border-box; }\n    body {\n        font-family: -apple-system, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;\n        font-size: 10.3px; color: #263630; margin: 0; padding: 0; line-height: 1.45;\n        -webkit-font-smoothing: antialiased;\n    }\n    b, strong { color: inherit; }\n\n    /* ── Palette ──\n       Ink           : #1c2b24   (body copy, strongest text)\n       Primary green : #164a2b   (deep forest — headings, borders)\n       Mid green     : #2f8452   (accents, links)\n       Muted green   : #5c7568   (secondary/eyebrow text)\n       Panel green   : #f4faf6   (soft panel background)\n       Hairline      : #dfeae4   (dividers — replaces heavy 1px grid borders)\n    */\n\n    /* ── Confidential strip ── */\n    .confidential-strip {\n        text-align: center; font-size: 7.3px; color: #8ba796;\n        letter-spacing: 2.6px; text-transform: uppercase;\n        margin-bottom: 10px; font-weight: 600;\n    }\n\n    /* ── Letterhead ── (table-cell layout: this PDF engine has no flexbox/grid support) */\n    .letterhead {\n        display: table; width: 100%; table-layout: fixed;\n        border-bottom: 2px solid #164a2b;\n        padding: 4px 0 12px 0; margin-bottom: 2px;\n    }\n    .letterhead .lh-cell { display: table-cell; vertical-align: middle; }\n    .letterhead .logo-cell { width: 185px; }\n    .letterhead img.logo { height: 56px; width: auto; display: block; }\n    .letterhead .org-block { padding: 0 0 0 16px; border-left: 1px solid #dfeae4; }\n    .letterhead .org-eyebrow { font-size: 8.3px; font-weight: 700; color: #2f8452; letter-spacing: 1.2px; text-transform: uppercase; margin-bottom: 4px; }\n    .letterhead .org-address { font-size: 8.5px; color: #5c7568; line-height: 1.75; }\n    .letterhead .doc-block { text-align: right; width: 195px; }\n    .letterhead .doc-title { font-size: 12px; font-weight: 700; color: #164a2b; text-transform: uppercase; letter-spacing: 0.8px; }\n    .letterhead .doc-ref { font-size: 8.4px; color: #6b7d73; margin-top: 4px; }\n    .letterhead .doc-ref b { color: #164a2b; font-weight: 600; }\n\n    /* ── Status badge (header) ── */\n    .status-pill {\n        display: inline-block; margin-top: 6px; padding: 3px 12px;\n        border-radius: 9px; font-size: 8.3px; font-weight: 700;\n        letter-spacing: 0.4px; color: #fff;\n    }\n    .status-closed    { background: #164a2b; }\n    .status-critical  { background: #9c3a2c; }\n    .status-caution   { background: #a97121; }\n    .status-progress  { background: #2f688f; }\n    .status-neutral   { background: #6b7a72; }\n\n    /* ── Section headings ── */\n    .section-heading {\n        background: #164a2b; color: #fff;\n        padding: 7px 13px; font-weight: 700; font-size: 9.8px;\n        margin: 22px 0 10px 0; letter-spacing: 0.8px; text-transform: uppercase;\n        border-radius: 2px;\n    }\n    .section-subheading {\n        color: #164a2b; border-bottom: 1.5px solid #164a2b;\n        padding: 0 0 3px 0; font-weight: 700; font-size: 9.3px;\n        margin: 15px 0 7px 0; letter-spacing: 0.3px; text-transform: uppercase;\n    }\n\n    /* ── Detail grid — clean label/value rows, no boxed grid ── */\n    .detail-grid { width: 100%; border-collapse: collapse; margin-bottom: 4px; }\n    .detail-grid td { padding: 6px 4px; vertical-align: top; border-bottom: 1px solid #eaf2ee; font-size: 9.8px; }\n    .detail-grid tr:last-child td { border-bottom: none; }\n    .detail-grid td.lbl {\n        width: 21%; font-weight: 600; color: #5c7568; white-space: nowrap;\n        font-size: 8.3px; text-transform: uppercase; letter-spacing: 0.3px; padding-top: 8px;\n    }\n    .detail-grid td.val { width: 29%; color: #1c2b24; font-weight: 500; padding-left: 10px; }\n\n    /* ── Data tables ── */\n    .data-table { width: 100%; border-collapse: collapse; margin-bottom: 14px; font-size: 9.4px; }\n    .data-table th {\n        background: #164a2b; color: #fff; padding: 7px 9px; text-align: left;\n        font-size: 8.3px; font-weight: 700; letter-spacing: 0.4px; text-transform: uppercase;\n    }\n    .data-table th:first-child { border-radius: 2px 0 0 0; }\n    .data-table th:last-child { border-radius: 0 2px 0 0; }\n    .data-table td { padding: 7px 9px; border-bottom: 1px solid #eaf2ee; vertical-align: top; }\n    .data-table tr:last-child td { border-bottom: 1px solid #dfeae4; }\n    .data-table tr:nth-child(even) td { background: #f8fbf9; }\n\n    /* ── Badges (semantic — kept legible regardless of theme) ── */\n    .badge { padding: 2.5px 10px; border-radius: 3px; font-size: 8.3px; font-weight: 700; display: inline-block; color: #fff; letter-spacing: 0.2px; }\n    .badge-dismissal { background: #9c3a2c; }\n    .badge-warning   { background: #a97121; }\n    .badge-closed    { background: #164a2b; }\n    .badge-info      { background: #2f688f; }\n    .badge-default   { background: #7c8a82; }\n\n    /* ── Outcome box ── */\n    .outcome-box {\n        border-left: 4px solid #164a2b; border-radius: 2px;\n        padding: 13px 18px; margin: 15px 0; background: #f4faf6;\n    }\n    .outcome-box .o-label { font-size: 8.2px; color: #5c7568; text-transform: uppercase; letter-spacing: 0.6px; margin-bottom: 4px; font-weight: 700; }\n    .outcome-box .o-value { font-size: 15px; font-weight: 700; color: #143a21; }\n\n    /* ── Text blocks ── */\n    .warning-block { background: #fdf7ec; border-left: 3px solid #a97121; padding: 11px 15px; margin: 7px 0 13px; font-size: 9.6px; white-space: pre-wrap; line-height: 1.6; color: #3d3020; }\n    .text-box { border: 1px solid #eaf2ee; border-radius: 2px; padding: 9px 12px; margin-top: 5px; background: #fbfdfc; font-size: 9.6px; line-height: 1.6; color: #33403a; }\n\n    /* ── Vertical timeline (Section 8) ── */\n    .timeline { position: relative; padding-left: 24px; margin: 8px 0 6px 4px; }\n    .timeline::before {\n        content: ''; position: absolute; left: 5px; top: 4px; bottom: 4px;\n        width: 1.5px; background: #dfeae4;\n    }\n    .tl-row { position: relative; padding-bottom: 16px; }\n    .tl-row:last-child { padding-bottom: 0; }\n    .tl-dot {\n        position: absolute; left: -24px; top: 1px; width: 12px; height: 12px;\n        border-radius: 50%; background: #e2e9e5; border: 2px solid #fff;\n        box-shadow: 0 0 0 1.5px #dfeae4;\n    }\n    .tl-row.done .tl-dot { background: #164a2b; box-shadow: 0 0 0 1.5px #164a2b; }\n    .tl-stage { font-weight: 700; font-size: 9.6px; color: #16321f; letter-spacing: 0.1px; }\n    .tl-row:not(.done) .tl-stage { color: #93a099; }\n    .tl-role { font-size: 8.2px; color: #6b7d73; font-style: italic; margin: 1px 0 3px 0; }\n    .tl-note { font-size: 9.2px; color: #3d4a44; }\n\n    /* ── Signature block ── */\n    .sig-row { display: table; width: 100%; table-layout: fixed; border-collapse: separate; border-spacing: 20px 0; margin: 34px -20px 0 -20px; }\n    .sig-block { display: table-cell; border-top: 1px solid #164a2b; padding-top: 7px; font-size: 8.9px; }\n    .sig-block .sig-label { font-weight: 700; color: #164a2b; margin-bottom: 4px; font-size: 8.7px; text-transform: uppercase; letter-spacing: 0.3px; }\n    .sig-block .sig-name  { color: #33403a; font-size: 8.9px; }\n    .sig-block .sig-sub   { color: #93a099; font-size: 8px; margin-top: 12px; }\n\n    /* ── Footer ── */\n    .page-footer {\n        border-top: 1px solid #dfeae4; margin-top: 24px; padding-top: 8px;\n        font-size: 8px; color: #93a099;\n        display: table; width: 100%;\n    }\n    .page-footer span { display: table-cell; }\n    .page-footer span.right { text-align: right; }\n\n    /* ── Summary banner (top of page 1, above section 1) ── */\n    .summary-strip {\n        display: table; width: 100%; table-layout: fixed;\n        border-collapse: separate; border-spacing: 4px 0;\n        margin: 15px -4px 4px -4px;\n    }\n    .summary-strip .s-card {\n        display: table-cell; background: #f4faf6; border-top: 2px solid #2f8452;\n        padding: 8px 11px;\n    }\n    .summary-strip .s-card .s-label { font-size: 7.4px; text-transform: uppercase; letter-spacing: 0.5px; color: #6b7d73; margin-bottom: 3px; font-weight: 600; }\n    .summary-strip .s-card .s-value { font-size: 10px; font-weight: 700; color: #143a21; }\n\n    @media print { body { margin: 0; } }\n</style>\n\n\n<!-- ── CONFIDENTIAL STRIP ────────────────────────────────────── -->\n<div class=\"confidential-strip\">— Confidential — Human Resources — Employee Relations —</div>\n\n{% set company = frappe.db.get_value('Employee', doc.employee, 'company') if doc.employee else '' %}\n{%- set report_logo = frappe.db.get_value(\"Company\", company, \"company_logo\") if company else None -%}\n{%- set report_logo = report_logo or \"/files/cropped-cropped-Zam-4.png\" -%}\n\n<!-- ════════════════════════════════════════════════════════════ -->\n<!-- LETTERHEAD                                                   -->\n<!-- ════════════════════════════════════════════════════════════ -->\n<div class=\"letterhead\">\n    <div class=\"lh-cell logo-cell\"><img class=\"logo\" src=\"{{ report_logo }}\"></div>\n    <div class=\"lh-cell org-block\">\n        <div class=\"org-eyebrow\">Human Resources — Employee Relations</div>\n        <div class=\"org-address\">\n            Stand No. LN15087/2, Great North Road, Lusaka<br>\n            Phone: +260 211 241296 &nbsp;|&nbsp; www.rea.org.zm\n        </div>\n    </div>\n    <div class=\"lh-cell doc-block\">\n        <div class=\"doc-title\">Disciplinary Case Report</div>\n        <div class=\"doc-ref\">Case No:&nbsp;<b>{{ doc.name }}</b></div>\n        <div class=\"doc-ref\">Printed:&nbsp;<b>{{ frappe.utils.today() }}</b></div>\n        <div>\n            {% if doc.workflow_state == 'Case Closed' %}\n                <span class=\"status-pill status-closed\">{{ doc.workflow_state }}</span>\n            {% elif doc.workflow_state in ['Hearing Outcome','Disciplinary Committee','Appeal Committee','Pending CEO Approval','Pending Outcome Approval','Appeal Outcome'] %}\n                <span class=\"status-pill status-critical\">{{ doc.workflow_state }}</span>\n            {% elif doc.workflow_state in ['Recommend Disciplinary Hearing','Exculpation Evaluation','Pending HR Manager Approval'] %}\n                <span class=\"status-pill status-caution\">{{ doc.workflow_state }}</span>\n            {% elif doc.workflow_state in ['Fill in Exculpation','Outcome Evaluation','Appeal Initiated'] %}\n                <span class=\"status-pill status-progress\">{{ doc.workflow_state }}</span>\n            {% else %}\n                <span class=\"status-pill status-neutral\">{{ doc.workflow_state }}</span>\n            {% endif %}\n        </div>\n    </div>\n</div>\n\n<!-- ── Quick summary strip ── -->\n<div class=\"summary-strip\">\n    <div class=\"s-card\">\n        <div class=\"s-label\">Employee</div>\n        <div class=\"s-value\">{{ doc.employee_name or '—' }}</div>\n    </div>\n    <div class=\"s-card\">\n        <div class=\"s-label\">Department</div>\n        <div class=\"s-value\">{{ doc.department or '—' }}</div>\n    </div>\n    <div class=\"s-card\">\n        <div class=\"s-label\">Charging Supervisor</div>\n        <div class=\"s-value\">{{ doc.name_of_charging_officer or '—' }}</div>\n    </div>\n    <div class=\"s-card\">\n        <div class=\"s-label\">Charges</div>\n        <div class=\"s-value\">{{ (doc.charge_description or []) | length }}</div>\n    </div>\n</div>\n\n\n<!-- ════════════════════════════════════════════════════════════ -->\n<!-- SECTION 1 — EMPLOYEE & INCIDENT DETAILS                      -->\n<!-- ════════════════════════════════════════════════════════════ -->\n<div class=\"section-heading\">1. Employee &amp; Incident Details</div>\n\n<!-- 1a. Employee (A. DETAILS OF THE OFFENDER) -->\n<div class=\"section-subheading\">A. Details of the Employee</div>\n<table class=\"detail-grid\">\n    <tr>\n        <td class=\"lbl\">Employee ID</td>\n        <td class=\"val\">{{ doc.employee or '—' }}</td>\n        <td class=\"lbl\">Employee Name</td>\n        <td class=\"val\">{{ doc.employee_name or '—' }}</td>\n    </tr>\n    <tr>\n        <td class=\"lbl\">Department</td>\n        <td class=\"val\">{{ doc.department or '—' }}</td>\n        <td class=\"lbl\">Job Title / Designation</td>\n        <td class=\"val\">{{ doc.designation or '—' }}</td>\n    </tr>\n</table>\n\n<!-- 1b. Supervisor (B. SUPERVISOR / CHARGING OFFICER) -->\n<div class=\"section-subheading\">B. Supervisor / Charging Officer</div>\n<table class=\"detail-grid\">\n    <tr>\n        <td class=\"lbl\">Supervisor (Link)</td>\n        <td class=\"val\">{{ doc.supervisor or '—' }}</td>\n        <td class=\"lbl\">Supervisor Name</td>\n        <td class=\"val\">{{ doc.name_of_charging_officer or '—' }}</td>\n    </tr>\n    <tr>\n        <td class=\"lbl\">Supervisor Designation</td>\n        <td class=\"val\">{{ doc.job_title_of_charging_officer or '—' }}</td>\n        <td class=\"lbl\">Charge Issued By</td>\n        <td class=\"val\">{{ doc.issued_by or '—' }}</td>\n    </tr>\n</table>\n\n<!-- 1c. Incident Details (C. DETAILS OF ALLEGED OFFENCE) -->\n<div class=\"section-subheading\">C. Details of Alleged Offence</div>\n<table class=\"detail-grid\">\n    <tr>\n        <td class=\"lbl\">Date of Occurrence</td>\n        <td class=\"val\">{{ frappe.utils.get_datetime(doc.creation).strftime('%Y-%m-%d') if doc.creation else '—' }}</td>\n        <td class=\"lbl\">Time of Occurrence</td>\n        <td class=\"val\">{{ frappe.utils.get_datetime(doc.creation).strftime('%H:%M') if doc.creation else '—' }}</td>\n    </tr>\n    <tr>\n        <td class=\"lbl\">Response Deadline</td>\n        <td class=\"val\">{{ doc.response_deadline or '—' }}</td>\n        <td class=\"lbl\">Charge Letter Attached</td>\n        <td class=\"val\">{% if doc.charge_letter %}Yes{% else %}No{% endif %}</td>\n    </tr>\n</table>\n\n<!-- ════════════════════════════════════════════════════════════ -->\n<!-- SECTION 2 — CHARGES PREFERRED                               -->\n<!-- ════════════════════════════════════════════════════════════ -->\n<div class=\"section-heading\">2. Charge(s) Preferred</div>\n\n{% if doc.charge_description %}\n<table class=\"data-table\">\n    <thead>\n        <tr>\n            <th style=\"width:4%\">#</th>\n            <th style=\"width:26%\">Offence</th>\n            <th style=\"width:11%\">Breach No.</th>\n            <th style=\"width:20%\">Prescribed Sanction</th>\n            <th style=\"width:14%\">Warning Expiry</th>\n            <th>Comments</th>\n        </tr>\n    </thead>\n    <tbody>\n        {% for c in doc.charge_description %}\n        <tr>\n            <td>{{ loop.index }}</td>\n            <td>\n                <b>{{ c.specific_offence or '—' }}</b>\n                {% if c.description %}<br><span style=\"color:#6f8577;font-size:9px;\">{{ c.description }}</span>{% endif %}\n            </td>\n            <td>{{ c.breach_number or '—' }}</td>\n            <td>\n                {% if c.prescribed_sanction == 'Summary Dismissal' %}\n                    <span class=\"badge badge-dismissal\">{{ c.prescribed_sanction }}</span>\n                {% elif 'Warning' in (c.prescribed_sanction or '') %}\n                    <span class=\"badge badge-warning\">{{ c.prescribed_sanction }}</span>\n                {% else %}\n                    {{ c.prescribed_sanction or '—' }}\n                {% endif %}\n            </td>\n            <td>{{ c.warning_expiry_date or 'N/A' }}</td>\n            <td>{{ c.comments or '' }}</td>\n        </tr>\n        {% endfor %}\n    </tbody>\n</table>\n\n<!-- Summary Dismissal alert banner if any charge carries it -->\n{% set ns = namespace(sd=0) %}\n{% for c in doc.charge_description %}\n    {% if c.prescribed_sanction == 'Summary Dismissal' %}{% set ns.sd = ns.sd + 1 %}{% endif %}\n{% endfor %}\n{% if ns.sd > 0 %}\n<div style=\"background:#fdf0ee;border:1px solid #a33122;border-radius:3px;padding:8px 12px;margin-bottom:12px;font-size:9.6px;color:#7a2519;\">\n    ⚠ <b>{{ ns.sd }} charge(s) carry a Summary Dismissal sanction.</b>\n    A Disciplinary Hearing is mandatory regardless of the exculpation outcome.\n</div>\n{% endif %}\n\n{% else %}\n<p style=\"color:#8a978f;font-style:italic;padding:6px 0;\">No charges recorded.</p>\n{% endif %}\n\n\n<!-- ════════════════════════════════════════════════════════════ -->\n<!-- SECTION 3 — EXCULPATION (EMPLOYEE RESPONSE)                 -->\n<!-- ════════════════════════════════════════════════════════════ -->\n{% if doc.employee_response or doc.select_outcome or doc.response_document %}\n<div class=\"section-heading\">3. Exculpation — Employee Response</div>\n\n<table class=\"detail-grid\">\n    <tr>\n        <td class=\"lbl\">Exculpation Outcome</td>\n        <td class=\"val\">\n            {% if doc.select_outcome %}\n                {% if doc.select_outcome == 'Satisfactory' %}\n                    <span class=\"badge badge-closed\">{{ doc.select_outcome }}</span>\n                {% elif doc.select_outcome == 'Unsatisfactory' %}\n                    <span class=\"badge badge-warning\">{{ doc.select_outcome }}</span>\n                {% elif doc.select_outcome == 'Proceed to Hearing' %}\n                    <span class=\"badge badge-dismissal\">{{ doc.select_outcome }}</span>\n                {% else %}\n                    {{ doc.select_outcome }}\n                {% endif %}\n            {% else %}—{% endif %}\n        </td>\n        <td class=\"lbl\">Response Document</td>\n        <td class=\"val\">{% if doc.response_document %}Attached{% else %}Not attached{% endif %}</td>\n    </tr>\n</table>\n\n{% if doc.employee_response %}\n<div style=\"margin-top:6px;margin-bottom:12px;\">\n    <b style=\"color:#1a5632;\">Employee's Written Response:</b>\n    <div class=\"text-box\">{{ doc.employee_response }}</div>\n</div>\n{% endif %}\n{% endif %}\n\n\n<!-- ════════════════════════════════════════════════════════════ -->\n<!-- SECTION 4 — WARNINGS ISSUED                                  -->\n<!-- ════════════════════════════════════════════════════════════ -->\n{% if doc.warning %}\n<div class=\"section-heading\">4. Warning(s) &amp; Notices Issued</div>\n\n<div style=\"margin-bottom:12px;\">\n    <div style=\"font-weight:bold;margin-bottom:3px;font-size:9.8px;\">\n        <span class=\"badge badge-warning\" style=\"margin-right:6px;\">Written Warning / CEO Rejection Record</span>\n    </div>\n    <div class=\"warning-block\">{{ doc.warning }}</div>\n</div>\n{% endif %}\n\n\n<!-- ════════════════════════════════════════════════════════════ -->\n<!-- SECTION 5 — DISCIPLINARY HEARING                            -->\n<!-- ════════════════════════════════════════════════════════════ -->\n{% if doc.hearing_outcome or doc.hearing_date or doc.hearing_decision %}\n<div class=\"section-heading\">5. Disciplinary Hearing</div>\n\n<table class=\"detail-grid\" style=\"margin-bottom:10px;\">\n    <tr>\n        <td class=\"lbl\">Hearing Date</td>\n        <td class=\"val\">{{ doc.hearing_date or '—' }}</td>\n        <td class=\"lbl\">Hearing Decision</td>\n        <td class=\"val\">\n            {% if doc.hearing_decision %}\n                {% if doc.hearing_decision == 'Dismissal' %}\n                    <span class=\"badge badge-dismissal\">{{ doc.hearing_decision }}</span>\n                {% elif doc.hearing_decision == 'Suspension' %}\n                    <span class=\"badge badge-warning\">{{ doc.hearing_decision }}</span>\n                {% elif doc.hearing_decision == 'Warning' %}\n                    <span class=\"badge badge-warning\">{{ doc.hearing_decision }}</span>\n                {% elif doc.hearing_decision == 'No Action' %}\n                    <span class=\"badge badge-closed\">{{ doc.hearing_decision }}</span>\n                {% else %}\n                    <b>{{ doc.hearing_decision }}</b>\n                {% endif %}\n            {% else %}—{% endif %}\n        </td>\n    </tr>\n    <tr>\n        <td class=\"lbl\">Hearing Report</td>\n        <td class=\"val\">{% if doc.hearing_report %}Attached{% else %}Not attached{% endif %}</td>\n        <td class=\"lbl\"></td>\n        <td class=\"val\"></td>\n    </tr>\n</table>\n\n<!-- Hearing Committee Members (field: hearing, DocType: Hearing Commitee) -->\n{% if doc.hearing %}\n<div style=\"margin-bottom:10px;\">\n    <b style=\"color:#1a5632;\">Hearing Committee Members:</b>\n    <table class=\"data-table\" style=\"margin-top:4px;\">\n        <thead>\n            <tr>\n                <th style=\"width:5%\">#</th>\n                <th style=\"width:45%\">Member Name</th>\n                <th>Role / Designation</th>\n            </tr>\n        </thead>\n        <tbody>\n            {% for m in doc.hearing %}\n            <tr>\n                <td>{{ loop.index }}</td>\n                <td>{{ m.employee_name or m.employee or '—' }}</td>\n                <td>{{ m.designation or '—' }}</td>\n            </tr>\n            {% endfor %}\n        </tbody>\n    </table>\n</div>\n{% endif %}\n\n<!-- Verdict per charge (field: hearing_outcome, DocType: Verdict) -->\n{% if doc.hearing_outcome %}\n<b style=\"color:#1a5632;\">Verdict per Charge:</b>\n<table class=\"data-table\" style=\"margin-top:4px;\">\n    <thead>\n        <tr>\n            <th style=\"width:4%\">#</th>\n            <th style=\"width:25%\">Offence</th>\n            <th style=\"width:11%\">Breach</th>\n            <th style=\"width:19%\">Prescribed Sanction</th>\n            <th style=\"width:12%\">Finding</th>\n            <th>Committee Notes</th>\n        </tr>\n    </thead>\n    <tbody>\n        {% for v in doc.hearing_outcome %}\n        <tr>\n            <td>{{ loop.index }}</td>\n            <td><b>{{ v.specific_offence or '—' }}</b></td>\n            <td>{{ v.breach_number or '—' }}</td>\n            <td>\n                {% if v.prescribed_sanction == 'Summary Dismissal' %}\n                    <span class=\"badge badge-dismissal\">{{ v.prescribed_sanction }}</span>\n                {% elif 'Warning' in (v.prescribed_sanction or '') %}\n                    <span class=\"badge badge-warning\">{{ v.prescribed_sanction }}</span>\n                {% else %}\n                    {{ v.prescribed_sanction or '—' }}\n                {% endif %}\n            </td>\n            <td>\n                {% if v.guilty == 'Guilty' %}\n                    <b style=\"color:#a33122;\">Guilty</b>\n                {% elif v.guilty == 'Not Guilty' %}\n                    <b style=\"color:#1a5632;\">Not Guilty</b>\n                {% else %}\n                    {{ v.guilty or '—' }}\n                {% endif %}\n            </td>\n            <td>{{ v.hearing_notes or '' }}</td>\n        </tr>\n        {% endfor %}\n    </tbody>\n</table>\n{% endif %}\n\n{% if doc.hearing_summary %}\n<div style=\"margin-top:8px;margin-bottom:4px;\">\n    <b style=\"color:#1a5632;\">Hearing Summary:</b>\n    <div class=\"text-box\">{{ doc.hearing_summary }}</div>\n</div>\n{% endif %}\n{% endif %}\n\n\n<!-- ════════════════════════════════════════════════════════════ -->\n<!-- SECTION 6 — APPEAL                                          -->\n<!-- ════════════════════════════════════════════════════════════ -->\n{% if doc.appeal_verdict or doc.grounds_for_appeal or doc.appeal_decision %}\n<div class=\"section-heading\">6. Appeal</div>\n\n<table class=\"detail-grid\" style=\"margin-bottom:10px;\">\n    <tr>\n        <td class=\"lbl\">Appeal Hearing Date</td>\n        <td class=\"val\">{{ doc.appeal_date or '—' }}</td>\n        <td class=\"lbl\">Appeal Chairperson</td>\n        <td class=\"val\">{{ doc.appeal_committee_chairperson or '—' }}</td>\n    </tr>\n    <tr>\n        <td class=\"lbl\">Final Appeal Decision</td>\n        <td class=\"val\">\n            {% if doc.appeal_decision == 'Approved' %}\n                <span class=\"badge badge-closed\">{{ doc.appeal_decision }}</span>\n            {% elif doc.appeal_decision == 'Rejected' %}\n                <span class=\"badge badge-dismissal\">{{ doc.appeal_decision }}</span>\n            {% else %}\n                {{ doc.appeal_decision or '—' }}\n            {% endif %}\n        </td>\n        <td class=\"lbl\">Appeal Hearing Report</td>\n        <td class=\"val\">{% if doc.appeal_hearing_report %}Attached{% else %}Not attached{% endif %}</td>\n    </tr>\n</table>\n\n{% if doc.grounds_for_appeal %}\n<div style=\"margin-bottom:10px;\">\n    <b style=\"color:#1a5632;\">Grounds for Appeal:</b>\n    <div class=\"text-box\">{{ doc.grounds_for_appeal }}</div>\n</div>\n{% endif %}\n\n<!-- Appeal Committee Members (field: appeal_members, DocType: Hearing Commitee) -->\n{% if doc.appeal_members %}\n<div style=\"margin-bottom:10px;\">\n    <b style=\"color:#1a5632;\">Appeal Committee Members:</b>\n    <table class=\"data-table\" style=\"margin-top:4px;\">\n        <thead>\n            <tr>\n                <th style=\"width:5%\">#</th>\n                <th style=\"width:45%\">Member Name</th>\n                <th>Role / Designation</th>\n            </tr>\n        </thead>\n        <tbody>\n            {% for m in doc.appeal_members %}\n            <tr>\n                <td>{{ loop.index }}</td>\n                <td>{{ m.employee_name or m.employee or '—' }}</td>\n                <td>{{ m.designation or '—' }}</td>\n            </tr>\n            {% endfor %}\n        </tbody>\n    </table>\n</div>\n{% endif %}\n\n<!-- Appeal Verdict per charge (field: appeal_verdict, DocType: Appeal Verdict) -->\n{% if doc.appeal_verdict %}\n<b style=\"color:#1a5632;\">Appeal Verdict per Charge:</b>\n<table class=\"data-table\" style=\"margin-top:4px;\">\n    <thead>\n        <tr>\n            <th style=\"width:4%\">#</th>\n            <th style=\"width:25%\">Offence</th>\n            <th style=\"width:14%\">Original Verdict</th>\n            <th style=\"width:14%\">Appeal Decision</th>\n            <th>Appeal Notes</th>\n        </tr>\n    </thead>\n    <tbody>\n        {% for a in doc.appeal_verdict %}\n        <tr>\n            <td>{{ loop.index }}</td>\n            <td><b>{{ a.specific_offence or '—' }}</b></td>\n            <td>\n                {% if a.original_verdict == 'Guilty' %}\n                    <b style=\"color:#a33122;\">Guilty</b>\n                {% elif a.original_verdict == 'Not Guilty' %}\n                    <b style=\"color:#1a5632;\">Not Guilty</b>\n                {% else %}\n                    {{ a.original_verdict or '—' }}\n                {% endif %}\n            </td>\n            <td>\n                {% if a.appeal_decision == 'Overturn' %}\n                    <b style=\"color:#1a5632;\">Overturned</b>\n                {% elif a.appeal_decision == 'Uphold' %}\n                    <b style=\"color:#a33122;\">Upheld</b>\n                {% elif a.appeal_decision == 'Vary' %}\n                    <b style=\"color:#b9791a;\">Varied</b>\n                {% else %}\n                    {{ a.appeal_decision or '—' }}\n                {% endif %}\n            </td>\n            <td>{{ a.appeal_notes or '' }}</td>\n        </tr>\n        {% endfor %}\n    </tbody>\n</table>\n{% endif %}\n\n{% if doc.final_remarks %}\n<div style=\"margin-top:8px;margin-bottom:4px;\">\n    <b style=\"color:#1a5632;\">Final Remarks:</b>\n    <div class=\"text-box\">{{ doc.final_remarks }}</div>\n</div>\n{% endif %}\n{% endif %}\n\n\n<!-- ════════════════════════════════════════════════════════════ -->\n<!-- SECTION 7 — FINAL CASE OUTCOME SUMMARY                      -->\n<!-- ════════════════════════════════════════════════════════════ -->\n<div class=\"section-heading\">7. Final Case Outcome</div>\n\n<div class=\"outcome-box\">\n    <div class=\"o-label\">Final Status</div>\n    <div class=\"o-value\">\n        {% if doc.workflow_state == 'Case Closed' %}\n            <span style=\"color:#1a5632;\">✔ Case Closed</span>\n        {% else %}\n            <span style=\"color:#a33122;\">⏳ {{ doc.workflow_state }} — In Progress</span>\n        {% endif %}\n    </div>\n</div>\n\n<table class=\"detail-grid\" style=\"margin-top:10px;\">\n    <tr>\n        <td class=\"lbl\">Reached Hearing</td>\n        <td class=\"val\">{% if doc.hearing_outcome %}Yes{% else %}No{% endif %}</td>\n        <td class=\"lbl\">Appeal Filed</td>\n        <td class=\"val\">{% if doc.appeal_verdict %}Yes{% else %}No{% endif %}</td>\n    </tr>\n    <tr>\n        <td class=\"lbl\">Total Charges</td>\n        <td class=\"val\">{{ (doc.charge_description or []) | length }}</td>\n        <td class=\"lbl\">Summary Dismissal Charges</td>\n        <td class=\"val\">\n            {% set ns2 = namespace(sd=0) %}\n            {% for c in (doc.charge_description or []) %}\n                {% if c.prescribed_sanction == 'Summary Dismissal' %}{% set ns2.sd = ns2.sd + 1 %}{% endif %}\n            {% endfor %}\n            {% if ns2.sd > 0 %}\n                <span class=\"badge badge-dismissal\">{{ ns2.sd }}</span>\n            {% else %}\n                0\n            {% endif %}\n        </td>\n    </tr>\n    <tr>\n        <td class=\"lbl\">Warning Issued</td>\n        <td class=\"val\">\n            {% if doc.warning %}Written{% else %}None{% endif %}\n        </td>\n        <td class=\"lbl\">Hearing Decision</td>\n        <td class=\"val\">{{ doc.hearing_decision or '—' }}</td>\n    </tr>\n    <tr>\n        <td class=\"lbl\">Case Opened</td>\n        <td class=\"val\">{{ frappe.utils.get_datetime(doc.creation).strftime('%Y-%m-%d') if doc.creation else '—' }}</td>\n        <td class=\"lbl\">Last Modified</td>\n        <td class=\"val\">{{ frappe.utils.get_datetime(doc.modified).strftime('%Y-%m-%d') if doc.modified else '—' }}</td>\n    </tr>\n</table>\n\n\n<!-- ════════════════════════════════════════════════════════════ -->\n<!-- SECTION 8 — PROCESS TIMELINE                                -->\n<!-- ════════════════════════════════════════════════════════════ -->\n<div class=\"section-heading\">8. Process Stages Reached</div>\n\n{% set stage_exculpation = (doc.employee_response or doc.select_outcome) %}\n{% set stage_warning = doc.warning %}\n{% set stage_hearing = doc.hearing_outcome %}\n{% set stage_appeal = (doc.appeal_verdict or doc.grounds_for_appeal) %}\n{% set stage_closed = (doc.workflow_state == 'Case Closed') %}\n\n<div class=\"timeline\">\n    <div class=\"tl-row done\">\n        <div class=\"tl-dot\"></div>\n        <div class=\"tl-stage\">Draft &amp; Charge Preferred</div>\n        <div class=\"tl-role\">Supervisor</div>\n        <div class=\"tl-note\">Incident documented; charge(s) formally preferred against employee.</div>\n    </div>\n\n    <div class=\"tl-row {% if stage_exculpation %}done{% endif %}\">\n        <div class=\"tl-dot\"></div>\n        <div class=\"tl-stage\">Exculpation</div>\n        <div class=\"tl-role\">Employee</div>\n        <div class=\"tl-note\">\n            {% if doc.select_outcome %}\n                Response recorded. Outcome: <b>{{ doc.select_outcome }}</b>.\n            {% elif doc.employee_response %}\n                Response submitted; outcome not yet recorded.\n            {% else %}\n                Not yet completed.\n            {% endif %}\n        </div>\n    </div>\n\n    <div class=\"tl-row {% if stage_warning %}done{% endif %}\">\n        <div class=\"tl-dot\"></div>\n        <div class=\"tl-stage\">Warning / Notice Issued</div>\n        <div class=\"tl-role\">Supervisor / HR</div>\n        <div class=\"tl-note\">\n            {% if doc.warning %}Written warning / CEO rejection notice recorded.\n            {% else %}No warning issued at this stage.{% endif %}\n        </div>\n    </div>\n\n    <div class=\"tl-row {% if stage_hearing %}done{% endif %}\">\n        <div class=\"tl-dot\"></div>\n        <div class=\"tl-stage\">Disciplinary Hearing</div>\n        <div class=\"tl-role\">Committee / HRO / CEO</div>\n        <div class=\"tl-note\">\n            {% if doc.hearing_decision %}\n                Decision: <b>{{ doc.hearing_decision }}</b>.\n                {% if doc.hearing_date %}Held on {{ doc.hearing_date }}.{% endif %}\n            {% elif doc.hearing_outcome %}\n                Hearing outcome recorded; awaiting CEO approval.\n            {% else %}\n                Hearing not yet held.\n            {% endif %}\n        </div>\n    </div>\n\n    <div class=\"tl-row {% if stage_appeal %}done{% endif %}\">\n        <div class=\"tl-dot\"></div>\n        <div class=\"tl-stage\">Appeal</div>\n        <div class=\"tl-role\">Appeal Committee / CEO</div>\n        <div class=\"tl-note\">\n            {% if doc.appeal_decision %}\n                Final appeal decision: <b>{{ doc.appeal_decision }}</b>.\n            {% elif doc.appeal_verdict %}\n                Appeal outcome recorded; pending approval.\n            {% elif doc.grounds_for_appeal %}\n                Appeal initiated; committee not yet convened.\n            {% else %}\n                No appeal filed.\n            {% endif %}\n        </div>\n    </div>\n\n    <div class=\"tl-row {% if stage_closed %}done{% endif %}\">\n        <div class=\"tl-dot\"></div>\n        <div class=\"tl-stage\">Case Closed</div>\n        <div class=\"tl-role\">CEO / HR</div>\n        <div class=\"tl-note\">\n            {% if stage_closed %}\n                Case formally closed and all documentation locked.\n            {% else %}\n                Pending — current stage: <b>{{ doc.workflow_state }}</b>.\n            {% endif %}\n        </div>\n    </div>\n</div>\n\n\n<!-- ════════════════════════════════════════════════════════════ -->\n<!-- SIGNATURE BLOCK                                              -->\n<!-- ════════════════════════════════════════════════════════════ -->\n<div class=\"sig-row\">\n    <div class=\"sig-block\">\n        <div class=\"sig-label\">Charging Officer / Supervisor</div>\n        <div class=\"sig-name\">{{ doc.name_of_charging_officer or '________________________________' }}</div>\n        <div class=\"sig-sub\">Signature &nbsp;&nbsp;&nbsp; Date: _______________</div>\n    </div>\n    <div class=\"sig-block\">\n        <div class=\"sig-label\">HR Officer</div>\n        <div class=\"sig-name\">________________________________</div>\n        <div class=\"sig-sub\">Signature &nbsp;&nbsp;&nbsp; Date: _______________</div>\n    </div>\n    <div class=\"sig-block\">\n        <div class=\"sig-label\">Employee Acknowledgement</div>\n        <div class=\"sig-name\">{{ doc.employee_name or '________________________________' }}</div>\n        <div class=\"sig-sub\">Signature &nbsp;&nbsp;&nbsp; Date: _______________</div>\n    </div>\n</div>\n\n\n<!-- ════════════════════════════════════════════════════════════ -->\n<!-- FOOTER                                                       -->\n<!-- ════════════════════════════════════════════════════════════ -->\n<div class=\"page-footer\">\n    <span>{{ company or 'Rural Electrification Authority' }} — Confidential HR Document — Not for general circulation</span>\n    <span class=\"right\">Case: {{ doc.name }} &nbsp;|&nbsp; Printed: {{ frappe.utils.today() }}</span>\n</div>\n",
